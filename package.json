{
	"name": "dyngja-cli",
	"version": "0.2.0",
	"description": "Unofficial CLI and MCP server for Dyngja, the virtual (play-money) Icelandic stock-market investing app.",
	"license": "MIT",
	"author": "Axel Paul Gunnarsson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/axelpaul/dyngja-cli.git"
	},
	"homepage": "https://github.com/axelpaul/dyngja-cli#readme",
	"bugs": {
		"url": "https://github.com/axelpaul/dyngja-cli/issues"
	},
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"bin": {
		"dyngja": "src/index.ts"
	},
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"build": "bun build --compile src/index.ts --outfile dist/dyngja",
		"typecheck": "bunx tsc --noEmit",
		"lint": "bunx biome check src/",
		"check": "bun run lint && bun run typecheck && bun run test",
		"test": "bun test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/bun": "latest",
		"typescript": "^5.6.0"
	}
}
